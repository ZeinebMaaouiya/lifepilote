# ──────────────────────────────────────────────────────────────────────────────
# Environment variables — copy to .env and fill in values
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lifepilot:changeme@localhost:5432/lifepilot
POSTGRES_DB=lifepilot
POSTGRES_USER=lifepilot
POSTGRES_PASSWORD=changeme

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App authentication ────────────────────────────────────────────────────────
# Public origin of the Better Auth issuer. Never put private signing keys here.
BETTER_AUTH_URL=http://localhost:3000
# Container-reachable JWKS URL. For Docker Desktop, use host.docker.internal.
BETTER_AUTH_JWKS_URL=http://host.docker.internal:3000/auth/api/jwks

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests.
CORS_ORIGINS=http://localhost:3000,https://your-figma-make-preview-url.com

# ── AI Providers (set the ones you want to use) ───────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LifePilot AI

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@lifepilot.ai

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=
BACKEND_URL=http://localhost:8000
