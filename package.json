{
  "name": "figma-make-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port ${PORT:-3000} --hostname 0.0.0.0",
    "build": "NODE_OPTIONS=--no-deprecation prisma generate && NODE_OPTIONS=--no-deprecation payload build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "format": "oxfmt",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "prisma:generate": "NODE_OPTIONS=--no-deprecation prisma generate",
    "prisma:migrate:dev": "NODE_OPTIONS=--no-deprecation prisma migrate dev",
    "prisma:migrate:deploy": "NODE_OPTIONS=--no-deprecation prisma migrate deploy"
  },
  "dependencies": {
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.4",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.4",
    "@payloadcms/plugin-mcp": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/translations": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "dotenv": "^18.0.9",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "nodemailer": "^10.3.1",
    "payload": "4.0.0-beta.4",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  }
}
